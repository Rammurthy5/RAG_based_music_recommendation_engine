# ==============================================================================
# Required API Keys
# ==============================================================================

# Choose the LLM provider used by rag-service: gemini or openai
LLM_PROVIDER=gemini

# Google API key for Gemini LLM (used by rag-service for generation)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API key for the OpenAI provider path
OPENAI_API_KEY=your-openai-api-key-here

# Optional model overrides
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-5.4-mini

# ==============================================================================
# Optional Observability
# ==============================================================================

# Enable LangSmith tracing for the RAG service.
# Use LANGSMITH_* as the canonical names. LANGCHAIN_* aliases are also accepted
# by the service for compatibility with existing LangChain setups.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=rag-music-recommender
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#
# If your LangSmith workspace is in the EU, use:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Genius API token (used by ingestion scripts to fetch lyrics)
GENIUS_ACCESS_TOKEN=your-genius-access-token-here

# MusicBrainz requires no API key — only a user-agent string (configured in code)

# ==============================================================================
# Optional Overrides (defaults are fine for local Docker Compose)
# ==============================================================================

# Weaviate connection (set by docker-compose, override for external Weaviate)
# WEAVIATE_HOST=weaviate
# WEAVIATE_HTTP_PORT=8080
# WEAVIATE_GRPC_PORT=50051

# RAG tuning
# TOP_K=10
# SIMILARITY_THRESHOLD=0.15
# HYBRID_ALPHA=0.5
# RETRIEVAL_CANDIDATE_MULTIPLIER=4
# RETRIEVAL_MIN_CANDIDATE_POOL=12
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CROSS_ENCODER_BATCH_SIZE=16
# CROSS_ENCODER_MAX_CANDIDATES=30
# LLM_TIMEOUT=15
# WEAVIATE_QUERY_TIMEOUT=5
# EMBEDDING_TIMEOUT=30

# Gateway settings
# RAG_SERVICE_URL=http://rag-service:8000
# PORT=8080
# RATE_LIMIT=20
# RATE_BURST=40
